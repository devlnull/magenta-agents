{
  "agent": "architect",
  "writes": [
    ".magenta/work/*/03-design.md",
    ".magenta/checks/architect.yaml",
    "docs/adr/**",
    "docs/rfc/**",
    "docs/architecture/**",
    "**/*ArchTest.*",
    "**/*ArchTests.*",
    "**/*ArchitectureTest.*",
    "**/*ArchitectureTests.*",
    "**/.dependency-cruiser.*",
    "**/.importlinter"
  ],
  "denies": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/secrets/**"
  ],
  "shell": [
    "git status*",
    "git log*",
    "git diff*",
    "git show*",
    "git rev-parse*",
    "git grep *",
    "ls*"
  ],
  "shell_deny": []
}