{
  "agent": "frontend",
  "writes": [
    "**",
    "!.magenta/**",
    ".magenta/work/*/06-impl-frontend.md",
    "!docs/adr/**",
    "!docs/rfc/**",
    "!**/acceptance/**",
    "!**/*ArchTest.*",
    "!**/*ArchTests.*",
    "!**/*ArchitectureTest.*",
    "!**/*ArchitectureTests.*",
    "!**/.dependency-cruiser.*",
    "!**/.importlinter"
  ],
  "denies": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/secrets/**"
  ],
  "shell": [
    "git status*",
    "git diff*",
    "git log*",
    "git show*",
    "git add *",
    "git commit *",
    "git rev-parse*",
    "ls*",
    "npm *",
    "npx *",
    "pnpm *",
    "yarn *",
    "./gradlew *",
    "flutter *",
    "dart *",
    "xcodebuild *",
    "\"*\" \"*/verify.py\" run*",
    "\"*\" \"*/verify.py\" list*",
    "\"*\" \"*/verify.py\" status*"
  ],
  "shell_deny": [
    "git push*",
    "*publish*",
    "*deploy*",
    "*--force*",
    "rm *",
    "git reset --hard*",
    "git checkout -- *",
    "git clean*"
  ]
}