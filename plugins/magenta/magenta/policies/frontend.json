{
  "agent": "frontend",
  "writes": [
    "**",
    "!.magenta/**",
    ".magenta/work/*/06-impl-frontend.md",
    "!docs/adr/**",
    "!docs/rfc/**",
    "!**/acceptance/**",
    "!**/*ArchTest.*",
    "!**/*ArchTests.*",
    "!**/*ArchitectureTest.*",
    "!**/*ArchitectureTests.*",
    "!**/.dependency-cruiser.*",
    "!**/.importlinter",
    "!.github/workflows/**",
    "!.github/actions/**",
    "!.gitlab-ci.yml",
    "!.gitlab/ci/**",
    "!**/Jenkinsfile",
    "!.circleci/**",
    "!azure-pipelines.yml",
    "!bitbucket-pipelines.yml",
    "!**/Dockerfile*",
    "!**/docker-compose*.yml",
    "!**/docker-compose*.yaml",
    "!**/compose.yml",
    "!**/compose.yaml",
    "!**/*.tf",
    "!**/terraform/**",
    "!**/helm/**",
    "!charts/**",
    "!**/k8s/**",
    "!kubernetes/**",
    "!kustomize/**",
    "!**/deploy/**",
    "!infra/**",
    "!infrastructure/**",
    "!monitoring/**",
    "!alerts/**",
    "!dashboards/**",
    "!**/*.rules.yml",
    "!**/*.rules.yaml",
    "!.semgrep.yml",
    "!.semgrep/**",
    "!.gitleaks.toml",
    "!.trivyignore",
    "!.snyk",
    "!osv-scanner.toml",
    "!docs/runbooks/**",
    "!docs/postmortems/**",
    "!runbooks/**",
    "!docs/architecture/**",
    "!**/.dockerignore",
    "!**/Chart.yaml",
    "!**/kustomization.yaml"
  ],
  "denies": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/secrets/**",
    "**/*.tfvars",
    "**/*.tfstate*"
  ],
  "shell": [
    "git status*",
    "git diff*",
    "git log*",
    "git show*",
    "git add *",
    "git commit *",
    "git rev-parse*",
    "ls*",
    "npm *",
    "npx *",
    "pnpm *",
    "yarn *",
    "./gradlew *",
    "flutter *",
    "dart *",
    "xcodebuild *",
    "\"*\" \"*/verify.py\" run*",
    "\"*\" \"*/verify.py\" list*",
    "\"*\" \"*/verify.py\" status*"
  ],
  "shell_deny": [
    "git push*",
    "*publish*",
    "*deploy*",
    "*--force*",
    "rm *",
    "git reset --hard*",
    "git checkout -- *",
    "git clean*"
  ]
}