{
  "agent": "platform",
  "writes": [
    ".github/workflows/**",
    ".github/actions/**",
    ".gitlab-ci.yml",
    ".gitlab/ci/**",
    "**/Jenkinsfile",
    ".circleci/**",
    "azure-pipelines.yml",
    "bitbucket-pipelines.yml",
    "**/Dockerfile*",
    "**/.dockerignore",
    "**/docker-compose*.yml",
    "**/docker-compose*.yaml",
    "**/compose.yml",
    "**/compose.yaml",
    "**/*.tf",
    "**/terraform/**",
    "**/helm/**",
    "charts/**",
    "k8s/**",
    "kubernetes/**",
    "kustomize/**",
    "deploy/**",
    "infra/**",
    "infrastructure/**",
    "monitoring/**",
    "alerts/**",
    "dashboards/**",
    "**/*.rules.yml",
    "**/*.rules.yaml",
    "!**/*.tfvars",
    "!**/*.tfstate*",
    ".magenta/work/*/06-impl-platform.md"
  ],
  "denies": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/secrets/**",
    "**/*.tfvars",
    "**/*.tfstate*"
  ],
  "shell": [
    "git status*",
    "git diff*",
    "git log*",
    "git show*",
    "git add *",
    "git commit *",
    "git rev-parse*",
    "ls*",
    "actionlint*",
    "hadolint *",
    "shellcheck *",
    "docker build *",
    "docker compose config*",
    "docker-compose config*",
    "kubeconform *",
    "kustomize build *",
    "helm lint *",
    "helm template *",
    "terraform fmt*",
    "terraform init -backend=false*",
    "terraform validate*",
    "tflint*",
    "checkov *",
    "promtool check *",
    "\"*\" \"*/verify.py\" run*",
    "\"*\" \"*/verify.py\" list*",
    "\"*\" \"*/verify.py\" status*"
  ],
  "shell_deny": [
    "git push*",
    "*--force*",
    "rm *",
    "git reset --hard*",
    "git checkout -- *",
    "git clean*",
    "terraform apply*",
    "terraform destroy*",
    "terraform import*",
    "terraform state*",
    "terraform plan*",
    "*kubectl*",
    "helm install*",
    "helm upgrade*",
    "helm uninstall*",
    "helm rollback*",
    "docker push*",
    "docker login*"
  ]
}