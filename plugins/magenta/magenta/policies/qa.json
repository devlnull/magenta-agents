{
  "agent": "qa",
  "writes": [
    ".magenta/work/*/05-test-plan.md",
    ".magenta/work/*/07-qa-report.md",
    ".magenta/work/*/acceptance/**"
  ],
  "denies": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/secrets/**"
  ],
  "shell": [
    "git status*",
    "git log*",
    "git diff*",
    "git show*",
    "git rev-parse*",
    "ls*",
    "./gradlew test*",
    "./gradlew check*",
    "./gradlew jmh*",
    "./gradlew gatling*",
    "./mvnw test*",
    "./mvnw verify*",
    "./mvnw gatling*",
    "mvn test*",
    "mvn verify*",
    "mvn gatling*",
    "npm test*",
    "npm run test*",
    "npx playwright test*",
    "pytest*",
    "dotnet test*",
    "go test*",
    "k6 run *",
    "wrk *",
    "wrk2 *",
    "hey *",
    "vegeta *",
    "ab *",
    "ghz *"
  ],
  "shell_deny": []
}