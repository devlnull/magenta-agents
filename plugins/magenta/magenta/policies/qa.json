{
  "agent": "qa",
  "writes": [
    ".magenta/work/*/05-test-plan.md",
    ".magenta/work/*/07-qa-report.md",
    ".magenta/work/*/acceptance/**",
    ".magenta/checks/qa.yaml",
    "test/**",
    "tests/**",
    "**/src/test/**",
    "**/src/*Test/**",
    "**/src/jmh/**",
    "**/src/gatling/**",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*_test.go",
    "**/test_*.py",
    "**/*_test.py",
    "**/*Tests/**",
    "**/e2e/**",
    "perf/**",
    "load-tests/**",
    "!**/*ArchTest.*",
    "!**/*ArchTests.*",
    "!**/*ArchitectureTest.*",
    "!**/*ArchitectureTests.*"
  ],
  "denies": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/secrets/**"
  ],
  "shell": [
    "git status*",
    "git log*",
    "git diff*",
    "git show*",
    "git rev-parse*",
    "ls*",
    "git add *",
    "git commit *",
    "./gradlew test*",
    "./gradlew :*:test*",
    "./gradlew check*",
    "./mvnw -pl * test*",
    "mvn -pl * test*",
    "yarn test*",
    "pnpm test*",
    "vendor/bin/phpunit*",
    "php artisan test*",
    "cargo test*",
    "make test*",
    "python -m pytest*",
    "python3 -m pytest*",
    "python -m unittest*",
    "python3 -m unittest*",
    "./gradlew jmh*",
    "./gradlew gatling*",
    "./mvnw test*",
    "./mvnw verify*",
    "./mvnw gatling*",
    "mvn test*",
    "mvn verify*",
    "mvn gatling*",
    "npm test*",
    "npm run test*",
    "npx playwright test*",
    "pytest*",
    "dotnet test*",
    "go test*",
    "k6 run *",
    "wrk *",
    "wrk2 *",
    "hey *",
    "vegeta *",
    "ab *",
    "ghz *",
    "\"*\" \"*/verify.py\" run*",
    "\"*\" \"*/verify.py\" list*",
    "\"*\" \"*/verify.py\" status*"
  ],
  "shell_deny": []
}